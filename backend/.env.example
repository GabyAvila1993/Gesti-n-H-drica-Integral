# =============================================================================
# GESTIÓN HÍDRICA INTEGRAL — CONFIGURACIÓN DE ENTORNO (BACKEND)
# =============================================================================
# Instrucciones:
# 1. Copiá este archivo como `.env` dentro de la carpeta `/backend`.
# 2. Completá las variables con tus credenciales obtenidas de las fuentes oficiales indicadas.
# 3. NUNCA subas tu archivo `.env` real al repositorio de Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVIDOR HTTP Y CORS
# -----------------------------------------------------------------------------
APP_NAME="Gestión Hídrica Integral"
PORT=3000
# En desarrollo local: http://localhost:5173
# En producción (Render / Cloud): dominio público de tu frontend o '*'
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL + EXTENSIÓN POSTGIS (Neon.tech)
# -----------------------------------------------------------------------------
# Obtené tu base de datos serverless gratuita con PostGIS en: https://neon.tech
# Pegá tu cadena de conexión completa con SSL requerido:
# Ejemplo: postgresql://[usuario]:[contraseña]@[host-neon]/neondb?sslmode=require
DATABASE_URL=
DB_SYNCHRONIZE=true

# -----------------------------------------------------------------------------
# 3. SEGURIDAD, AUTENTICACIÓN JWT Y CONTRASEÑAS (RBAC)
# -----------------------------------------------------------------------------
# Clave secreta para firmar tokens JWT. Generá una cadena segura y aleatoria.
# (Ejemplo para generar en consola: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# 4. ALMACENAMIENTO DE IMÁGENES Y AUDITORÍA FOTOGRÁFICA
# -----------------------------------------------------------------------------
# Proveedor de almacenamiento: 'local' (guarda en /uploads) | 's3' | 'cloudinary'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_PATH=/uploads
UPLOAD_MAX_SIZE_MB=10

# -----------------------------------------------------------------------------
# 5. MONITOREO SATELITAL DE CANALES (Índice MNDWI · DGI Mendoza)
# -----------------------------------------------------------------------------
# Proveedor satelital: 'mock' (red georreferenciada DGI Mendoza) | 'copernicus'
SATELLITE_PROVIDER=mock
SATELLITE_MOCK_SEED=2026

# Credenciales oficiales de Copernicus Data Space Ecosystem (opcional para datos en vivo):
# Obtené tus credenciales en: https://dataspace.copernicus.eu
COPERNICUS_API_URL=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Umbrales del índice espectral MNDWI para clasificar humedad anómala
MNDWI_LEAK_THRESHOLD=0.2
MNDWI_MEDIUM_THRESHOLD=0.3
MNDWI_CRITICAL_THRESHOLD=0.4

# -----------------------------------------------------------------------------
# 6. VISIÓN ARTIFICIAL EN ACEQUIAS URBANAS (Groq LPU)
# -----------------------------------------------------------------------------
# Proveedor de visión IA: 'mock' | 'groq' | 'huggingface' | 'roboflow'
AI_VISION_PROVIDER=mock

# API Key de Groq Cloud para análisis multimodal ultra-rápido:
# Obtené tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Proveedores alternativos de visión (opcionales):
GEMINI_API_KEY=
# Tokens de Hugging Face: https://huggingface.co/settings/tokens
HUGGINGFACE_API_URL=
HUGGINGFACE_TOKEN=
ROBOFLOW_API_URL=
ROBOFLOW_API_KEY=
