# ---------------------------------------------
# Servidor
# ---------------------------------------------
APP_NAME="Gestión Hídrica Integral"
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------
# Monitoreo satelital
#   SATELLITE_PROVIDER: mock | copernicus
# ---------------------------------------------
SATELLITE_PROVIDER=mock
SATELLITE_MOCK_SEED=2026
COPERNICUS_API_URL=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Umbrales MNDWI para clasificar humedad anómala
MNDWI_LEAK_THRESHOLD=0.2
MNDWI_MEDIUM_THRESHOLD=0.3
MNDWI_CRITICAL_THRESHOLD=0.4

# ---------------------------------------------
# Visión por computadora (Fase 2)
#   AI_VISION_PROVIDER: mock | huggingface | roboflow
# ---------------------------------------------
AI_VISION_PROVIDER=mock
HUGGINGFACE_API_URL=
HUGGINGFACE_TOKEN=
ROBOFLOW_API_URL=
ROBOFLOW_API_KEY=
UPLOAD_MAX_SIZE_MB=10

# ---------------------------------------------
# Base de Datos PostgreSQL + PostGIS (Fase 5 - Neon.tech)
# Ejemplo Neon: postgresql://neondb_owner:pass@ep-cool-water.us-east-2.aws.neon.tech/neondb?sslmode=require
# Si DATABASE_URL se deja vacío en desarrollo local, el sistema opera con persistencia en memoria sincronizada
# y al definir DATABASE_URL activa automáticamente TypeORM + extensión PostGIS.
# ---------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_cSoT93VvJjgC@ep-morning-wildflower-b6zbothj-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_SYNCHRONIZE=true

# ---------------------------------------------
# Seguridad JWT y Bcrypt (RBAC Municipal)
# ---------------------------------------------
JWT_SECRET=ghi-mendoza-jwt-secret-2026-operativa-municipal
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------
# Almacenamiento de Imágenes (local | s3 | cloudinary)
# ---------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_PATH=/uploads
