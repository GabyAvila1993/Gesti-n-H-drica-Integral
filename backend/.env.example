# =============================================================================
# GESTIÓN HÍDRICA INTEGRAL — CONFIGURACIÓN DE ENTORNO (BACKEND)
# =============================================================================
# Instrucciones rápidas:
# - Desarrollo local: copiá este archivo como `.env` dentro de `/backend`.
# - Despliegue en Render: cargá estas claves en la pestaña "Environment" del Web Service.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVIDOR HTTP Y CORS
# -----------------------------------------------------------------------------
# Nombre visible en los encabezados y documentación OpenAPI (/api/docs)
APP_NAME="Gestión Hídrica Integral"

# Puerto HTTP del servidor:
# - Local: 3000
# - Render (Cloud): Opcional; Render inyecta automáticamente su propio `PORT` dinámico
#   y el servidor escucha sobre `0.0.0.0`.
PORT=3000

# Orígenes permitidos por CORS:
# - Local: http://localhost:5173
# - Producción / Demo en la nube (Render + Vercel/Netlify): usar `*` para permitir
#   acceso desde cualquier dominio de prueba o especificar la URL exacta del frontend.
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL + POSTGIS (Fase 5 — Neon.tech)
# -----------------------------------------------------------------------------
# Cadena de conexión completa a PostgreSQL con soporte PostGIS.
# - Local sin Postgres instalado: dejar vacío (`DATABASE_URL=`) para operar con el
#   almacén en memoria sincronizado y datos semilla de Mendoza.
# - Producción / Neon.tech: pegar la URL con `?sslmode=require`. Al iniciar, el backend
#   ejecuta automáticamente `CREATE EXTENSION IF NOT EXISTS postgis;` y crea las tablas.
#   Ejemplo: postgresql://neondb_owner:AbC123xyz@ep-water-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Sincronización automática del esquema inicial PostGIS al iniciar (true recomendado para la demo)
DB_SYNCHRONIZE=true

# Parámetros individuales alternativos (solo si no se usa DATABASE_URL y se conecta a un Postgres local)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=gestion_hidrica
DB_SSL=false

# -----------------------------------------------------------------------------
# 3. SEGURIDAD, AUTENTICACIÓN JWT Y ROLES MUNICIPALES (RBAC)
# -----------------------------------------------------------------------------
# Clave secreta para firmar y verificar los tokens Bearer JWT (roles ADMIN, ENCARGADO, CUADRILLA).
# - Local: podés mantener el valor por defecto.
# - Producción (Render): reemplazar por una cadena aleatoria larga (mínimo 32 caracteres).
JWT_SECRET=ghi-mendoza-jwt-secret-2026-operativa-municipal

# Tiempo de validez de la sesión municipal (ej. 12h, 24h, 7d)
JWT_EXPIRES_IN=12h

# Costo de hashing para contraseñas de usuarios con bcryptjs (10 recomendado en nube)
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# 4. ALMACENAMIENTO DE IMÁGENES Y AUDITORÍA FOTOGRÁFICA ("Antes" y "Después")
# -----------------------------------------------------------------------------
# Adaptador de almacenamiento activo:
# - `local`: guarda en disco dentro del contenedor y sirve estáticamente en `/uploads`
# - Preparado para extender a `s3` o `cloudinary` mediante `STORAGE_PROVIDER`
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_PATH=/uploads

# Tamaño máximo permitido por fotografía subida en MB (aplica a análisis IA y evidencias de cuadrilla)
UPLOAD_MAX_SIZE_MB=10

# -----------------------------------------------------------------------------
# 5. MONITOREO SATELITAL DE CANALES DE RIEGO (Fase 1 — Índice MNDWI)
# -----------------------------------------------------------------------------
# Proveedor satelital:
# - `mock`: utiliza la red georreferenciada real de canales/hijuelas de Mendoza (`mendoza-canals.mock.json`)
# - `copernicus`: conecta con Copernicus Data Space Ecosystem (requiere credenciales OAuth2)
SATELLITE_PROVIDER=mock
SATELLITE_MOCK_SEED=2026

# Credenciales opcionales para `SATELLITE_PROVIDER=copernicus`
COPERNICUS_API_URL=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Umbrales del índice espectral MNDWI para clasificar anomalías de humedad / fugas
MNDWI_LEAK_THRESHOLD=0.2
MNDWI_MEDIUM_THRESHOLD=0.3
MNDWI_CRITICAL_THRESHOLD=0.4

# -----------------------------------------------------------------------------
# 6. VISIÓN POR COMPUTADORA EN ACEQUIAS URBANAS (Fase 2)
# -----------------------------------------------------------------------------
# Proveedor de análisis de imágenes:
# - `mock` (recomendado si no tenés API Key externa): usa el JSON calibrado para las
#   3 escenas de muestra y el analizador local píxel por píxel (`pixel-vision.analyzer.ts`)
#   con filtro de textura 2D para fotos reales subidas por Drag & Drop.
# - `huggingface`: usa la API de inferencia de Hugging Face (`facebook/detr-resnet-50`)
#   para fotos personalizadas (exige `HUGGINGFACE_TOKEN`).
# - `roboflow`: conecta con un modelo alojado en Roboflow.
AI_VISION_PROVIDER=mock

# API Key de Google Gemini (`gemini-1.5-flash`) para visión artificial de acequias
GEMINI_API_KEY=

# Credenciales opcionales para `AI_VISION_PROVIDER=huggingface`
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models/facebook/detr-resnet-50
HUGGINGFACE_TOKEN=

# Credenciales opcionales para `AI_VISION_PROVIDER=roboflow`
ROBOFLOW_API_URL=
ROBOFLOW_API_KEY=
