# =============================================================================
# GESTIÓN HÍDRICA INTEGRAL — CONFIGURACIÓN DE ENTORNO (FRONTEND · VITE)
# =============================================================================
# Instrucciones:
# 1. Copiá este archivo como `.env` dentro de la carpeta `/frontend`.
# 2. En desarrollo local, configurá la URL de tu API local.
# 3. En producción (Render Static Site), agregá estas variables en la sección
#    "Environment" de tu dashboard de Render antes de compilar.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CONEXIÓN CON EL BACKEND (API NESTJS)
# -----------------------------------------------------------------------------
# URL base pública del servidor backend.
# - Desarrollo local: http://localhost:3000
# - Producción (Render): URL de tu Web Service en https://render.com
VITE_API_URL=

# -----------------------------------------------------------------------------
# 2. CONFIGURACIÓN CARTOGRÁFICA Y MAPAS (LEAFLET / OPENSTREETMAP)
# -----------------------------------------------------------------------------
# Proveedor oficial de teselas abiertas: https://www.openstreetmap.org
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Coordenadas geográficas iniciales (Gran Mendoza: latitud, longitud) y nivel de zoom
VITE_MAP_DEFAULT_CENTER=-32.92,-68.83
VITE_MAP_DEFAULT_ZOOM=12
