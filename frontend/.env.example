# =============================================================================
# GESTIÓN HÍDRICA INTEGRAL — CONFIGURACIÓN DE ENTORNO (FRONTEND · VITE)
# =============================================================================
# Instrucciones rápidas:
# - Desarrollo local: copiá este archivo como `.env` dentro de `/frontend`.
# - Producción (Render Static Site): agregá `VITE_API_URL` en la sección
#   "Environment Variables" de tu Static Site en Render antes del build.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CONEXIÓN CON EL BACKEND (API NESTJS)
# -----------------------------------------------------------------------------
# URL base del servidor backend (el cliente HTTP agrega `/api` automáticamente
# si no se incluye al final, y resuelve `/uploads` sobre este mismo dominio).
#
# - En Desarrollo Local usar:
#   VITE_API_URL=http://localhost:3000
#
# - En Producción (Render) usar:
#   VITE_API_URL=https://gesti-n-h-drica-integral.onrender.com
VITE_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. CONFIGURACIÓN DEL MAPA CARTOGRÁFICO (LEAFLET / OPENSTREETMAP)
# -----------------------------------------------------------------------------
# Proveedor de teselas y atribución
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Coordenadas iniciales del Gran Mendoza (lat,lng) y nivel de zoom por defecto
VITE_MAP_DEFAULT_CENTER=-32.92,-68.83
VITE_MAP_DEFAULT_ZOOM=12
