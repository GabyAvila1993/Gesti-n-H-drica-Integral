# URL base de la API NestJS
VITE_API_URL=http://localhost:3000/api

# Mapa base (OpenStreetMap por defecto; reemplazable por otro proveedor de teselas)
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Centro inicial: Ciudad de Mendoza (lat,lng)
VITE_MAP_DEFAULT_CENTER=-32.92,-68.83
VITE_MAP_DEFAULT_ZOOM=12
